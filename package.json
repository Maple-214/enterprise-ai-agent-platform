{
  "name": "enterprise-ai-agent-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:test": "pnpm --dir apps/web test",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f --tail=200",
    "infra:up": "docker compose up -d postgres redis qdrant minio",
    "infra:down": "docker compose stop postgres redis qdrant minio",
    "agent:dev": "uv run --directory services/agent uvicorn app.main:app --reload --port 8000",
    "worker:dev": "uv run --directory services/worker python worker.py",
    "dev:infra": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1"
  }
}
